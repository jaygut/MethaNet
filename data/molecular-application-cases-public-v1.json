      "id": "interpret",
      "question": "Does this genome support methane oxidation?",
      "record": "OWC_1706",
      "setting": "Old Woman Creek · freshwater wetland",
      "finding": "OWC_1706 carries source-assigned component labels from the copper-containing monooxygenase family, known as CuMMO. Earlier MethaNet screening flagged an ammonia-oxidation alternative. The candidate remains on hold for substrate-specific review.",
      "decision": "Keep the candidate on hold for substrate-specific review. Its eligibility for methane-consumer summaries depends on resolving that review.",
      "next_action": "Compare the enzyme subunits, neighboring genes and MethaNet screening notes. Use these findings to choose an assay that distinguishes ammonia oxidation from methane oxidation.",
      "boundary": "Ammonia oxidation remains a candidate interpretation. Establishing the enzyme's substrate and methane-consumption rate requires experimental evidence.",
      "numbers": "8 annotation records cover 4 distinct source genes and 3 component labels.",
      "status": "Mechanism review required",
      "proteome_id": "mucc_v1__OWC_1706",
      "completeness": 81.21,
      "contamination": 4.55,
      "source_id": "mucc"
    },
