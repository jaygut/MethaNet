        dashboard=f"{RESULTS}/cohort/platform_demo/platform_dashboard_snapshot.json",
        recommendations=f"{RESULTS}/cohort/platform_demo/candidate_recommendation_table.tsv",
    conda:
        "envs/integration.yaml"
    shell:
