"""
MethaNet functional-metagenomics expansion backbone.

This scaffold is designed for:
1. single-MAG pilot mode via --config pilot_mag_id=<MAG_ID>
2. bridge-panel mode via a filtered manifest
3. full-cohort mode across the 662-genome POC MAG/proteome set

Promotion requirement:
Implement the parser/integration scripts referenced under
workflow/scripts/functional_metagenomics/ before treating this as production.
"""

import os
from pathlib import Path

import pandas as pd


RESULTS = config["paths"]["results"]
LOGS = config["paths"]["logs"]
DB = config["databases"]
PARAMS = config["params"]
THREADS = config["threads"]

MANIFEST = config["inputs"]["mag_manifest"]
PILOT_MAG_ID = config.get("pilot_mag_id") or config.get("pilot", {}).get("pilot_mag_id")


def load_manifest():
    manifest = pd.read_csv(MANIFEST, sep="\t", dtype=str)
    required = {"mag_id", "fasta_path", "ecosystem", "source"}
    missing = required - set(manifest.columns)
    if missing:
        raise ValueError(f"mag_manifest missing required columns: {sorted(missing)}")
    if PILOT_MAG_ID:
        manifest = manifest.loc[manifest["mag_id"] == str(PILOT_MAG_ID)].copy()
        if manifest.empty:
            raise ValueError(f"pilot_mag_id not found in manifest: {PILOT_MAG_ID}")
    return manifest


MAG_TABLE = load_manifest()
MAGS = MAG_TABLE["mag_id"].tolist()
FASTA_BY_MAG = dict(zip(MAG_TABLE["mag_id"], MAG_TABLE["fasta_path"]))


def mag_fasta(wildcards):
    return FASTA_BY_MAG[wildcards.mag_id]


rule all:
    input:
        f"{RESULTS}/manifests/mag_manifest.resolved.tsv",
        f"{RESULTS}/manifests/tool_db_manifest.tsv",
        f"{RESULTS}/cohort/qc_taxonomy/mag_qc_integrated.tsv",
        f"{RESULTS}/cohort/qc_taxonomy/taxonomy_resolved.tsv",
        f"{RESULTS}/cohort/qc_taxonomy/derep_clusters.tsv",
        f"{RESULTS}/cohort/functional_matrices/methane_marker_panel.tsv",
        f"{RESULTS}/cohort/functional_matrices/methane_pathway_completeness.tsv",
        f"{RESULTS}/cohort/functional_matrices/annotation_coverage_qc.tsv",
        f"{RESULTS}/cohort/bridge_cards/bridge_mechanism_cards.json",
        f"{RESULTS}/cohort/latent_function/latent_function_joined_features.parquet",
        f"{RESULTS}/cohort/platform_demo/mrv_feature_table.parquet",
        f"{RESULTS}/cohort/platform_demo/platform_dashboard_snapshot.json",


rule resolve_manifest:
    input:
        manifest=MANIFEST,
        embedding_metadata=config["inputs"]["embedding_metadata"],
        bridge_metrics=config["inputs"]["bridge_metrics"],
    output:
        f"{RESULTS}/manifests/mag_manifest.resolved.tsv",
    conda:
        "envs/integration.yaml"
    shell:
        """
        mkdir -p {RESULTS}/manifests
        python workflow/scripts/functional_metagenomics/resolve_mag_manifest.py \
          --manifest {input.manifest} \
          --embedding-metadata {input.embedding_metadata} \
          --bridge-metrics {input.bridge_metrics} \
          --out {output}
        """


rule write_tool_db_manifest:
    output:
        f"{RESULTS}/manifests/tool_db_manifest.tsv",
    params:
        configfile="ai_docs/functional_metagenomics_expansion/snakemake_backbone/config.apollo3.yaml",
    conda:
        "envs/integration.yaml"
    shell:
        """
        mkdir -p {RESULTS}/manifests
        python workflow/scripts/functional_metagenomics/write_tool_db_manifest.py \
          --config {params.configfile} \
          --out {output}
        """


rule stage_mag_set:
    output:
        directory(f"{RESULTS}/staged_genomes"),
    run:
        outdir = Path(output[0])
        outdir.mkdir(parents=True, exist_ok=True)
        for mag_id, fasta in FASTA_BY_MAG.items():
            target = outdir / f"{mag_id}.{PARAMS['fasta_extension']}"
            if target.exists() or target.is_symlink():
                target.unlink()
            os.symlink(Path(fasta).resolve(), target)


rule quast:
    input:
        fasta=mag_fasta,
    output:
        report=f"{RESULTS}/per_mag/{{mag_id}}/qc/quast/report.tsv",
    threads:
        THREADS["light"]
    resources:
        mem_mb=config["resources"]["mem_light_mb"]
    conda:
        "envs/qc.yaml"
    shell:
        """
        mkdir -p $(dirname {output.report}) {LOGS}/quast
        quast.py {input.fasta} \
          -o {RESULTS}/per_mag/{wildcards.mag_id}/qc/quast \
          -t {threads} \
          > {LOGS}/quast/{wildcards.mag_id}.out \
          2> {LOGS}/quast/{wildcards.mag_id}.err
        """


rule checkm2_all:
    input:
        genomes=rules.stage_mag_set.output,
    output:
        report=f"{RESULTS}/cohort/qc_taxonomy/checkm2/quality_report.tsv",
    threads:
        THREADS["heavy"]
    resources:
        mem_mb=config["resources"]["mem_bigmem_mb"]
    conda:
        "envs/qc.yaml"
    shell:
        """
        mkdir -p {RESULTS}/cohort/qc_taxonomy/checkm2 {LOGS}/checkm2
        checkm2 predict \
          --input {input.genomes} \
          --output-directory {RESULTS}/cohort/qc_taxonomy/checkm2 \
          --threads {threads} \
          --extension {PARAMS[fasta_extension]} \
          --database_path {DB[checkm2]} \
          > {LOGS}/checkm2/checkm2.out \
          2> {LOGS}/checkm2/checkm2.err
        """


