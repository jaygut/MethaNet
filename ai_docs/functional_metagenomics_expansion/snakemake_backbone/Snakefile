        "envs/annotation.yaml"
    shell:
        """
        mkdir -p {RESULTS}/per_mag/{wildcards.mag_id}/annotation/eggnog {LOGS}/eggnog
        emapper.py \
          -m diamond \
          --itype proteins \
          -i {input.faa} \
          --data_dir {DB[eggnog_v2]} \
          --cpu {threads} \
          -o {wildcards.mag_id} \
          --output_dir {RESULTS}/per_mag/{wildcards.mag_id}/annotation/eggnog \
          > {LOGS}/eggnog/{wildcards.mag_id}.out \
          2> {LOGS}/eggnog/{wildcards.mag_id}.err
        """


rule mcycdb:
    input:
        faa=rules.prodigal.output.faa,
    output:
        raw=f"{RESULTS}/per_mag/{{mag_id}}/annotation/mcycdb/{{mag_id}}.diamond.tsv",
        parsed=f"{RESULTS}/per_mag/{{mag_id}}/annotation/mcycdb/{{mag_id}}.mcycdb_hits.tsv",
    threads:
        THREADS["medium"]
    resources:
        mem_mb=config["resources"]["mem_medium_mb"]
    conda:
        "envs/annotation.yaml"
    shell:
        """
        mkdir -p {RESULTS}/per_mag/{wildcards.mag_id}/annotation/mcycdb {LOGS}/mcycdb
        diamond blastp \
          -q {input.faa} \
          -d {DB[mcycdb_diamond]} \
          -o {output.raw} \
          -f 6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore qcovhsp scovhsp \
          --evalue {PARAMS[diamond_evalue]} \
          --query-cover {PARAMS[diamond_query_cover]} \
          --subject-cover {PARAMS[diamond_subject_cover]} \
          --threads {threads} \
          > {LOGS}/mcycdb/{wildcards.mag_id}.out \
          2> {LOGS}/mcycdb/{wildcards.mag_id}.err
        python workflow/scripts/functional_metagenomics/parse_mcycdb_hits.py \
          --diamond {output.raw} \
          --id2gene {DB[mcycdb_id2gene]} \
          --identity {PARAMS[diamond_identity]} \
          --out {output.parsed}
        """


