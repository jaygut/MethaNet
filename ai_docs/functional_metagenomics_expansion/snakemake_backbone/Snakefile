        mkdir -p {RESULTS}/cohort/qc_taxonomy
        python workflow/scripts/functional_metagenomics/integrate_qc_taxonomy.py \
          --manifest {input.manifest} \
          --checkm2 {input.checkm2} \
          --gunc {input.gunc} \
          --gtdb-bac {input.gtdb_bac} \
          --gtdb-ar {input.gtdb_ar} \
          --drep-cdb {input.drep_cdb} \
          --drep-wdb {input.drep_wdb} \
          --out-qc {output.qc} \
          --out-taxonomy {output.taxonomy} \
          --out-derep {output.derep}
        """


rule prodigal:
    input:
        fasta=mag_fasta,
    output:
        faa=f"{RESULTS}/per_mag/{{mag_id}}/genes/{{mag_id}}.faa",
        ffn=f"{RESULTS}/per_mag/{{mag_id}}/genes/{{mag_id}}.ffn",
        gff=f"{RESULTS}/per_mag/{{mag_id}}/genes/{{mag_id}}.gff",
    threads:
        THREADS["light"]
    resources:
        mem_mb=config["resources"]["mem_light_mb"]
    conda:
        "envs/annotation.yaml"
    shell:
        """
        mkdir -p {RESULTS}/per_mag/{wildcards.mag_id}/genes {LOGS}/prodigal
        prodigal \
          -i {input.fasta} \
          -a {output.faa} \
          -d {output.ffn} \
          -o {output.gff} \
          -f gff \
          -p {PARAMS[prodigal_mode]} \
          > {LOGS}/prodigal/{wildcards.mag_id}.out \
          2> {LOGS}/prodigal/{wildcards.mag_id}.err
        """


rule kofam:
    input:
        faa=rules.prodigal.output.faa,
    output:
        f"{RESULTS}/per_mag/{{mag_id}}/annotation/kofam/{{mag_id}}.kofam.detail.tsv",
    threads:
        THREADS["medium"]
    resources:
        mem_mb=config["resources"]["mem_medium_mb"]
    conda:
        "envs/annotation.yaml"
    shell:
        """
        mkdir -p {RESULTS}/per_mag/{wildcards.mag_id}/annotation/kofam {LOGS}/kofam
        exec_annotation \
          --cpu {threads} \
          --profile {DB[kofam_profiles]} \
          --ko-list {DB[kofam_ko_list]} \
          --format detail-tsv \
          -o {output} \
          {input.faa} \
          > {LOGS}/kofam/{wildcards.mag_id}.out \
          2> {LOGS}/kofam/{wildcards.mag_id}.err
        """


rule eggnog_v2:
    input:
        faa=rules.prodigal.output.faa,
    output:
