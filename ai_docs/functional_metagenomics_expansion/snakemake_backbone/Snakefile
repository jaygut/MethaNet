rule drep_all:
    input:
        genomes=rules.stage_mag_set.output,
        checkm2=rules.checkm2_all.output.report,
    output:
        cdb=f"{RESULTS}/cohort/qc_taxonomy/drep/data_tables/Cdb.csv",
        wdb=f"{RESULTS}/cohort/qc_taxonomy/drep/data_tables/Wdb.csv",
    threads:
        THREADS["heavy"]
    resources:
        mem_mb=config["resources"]["mem_bigmem_mb"]
    conda:
        "envs/qc.yaml"
    shell:
        """
        mkdir -p {RESULTS}/cohort/qc_taxonomy/drep {LOGS}/drep
        dRep dereplicate {RESULTS}/cohort/qc_taxonomy/drep \
          -g {input.genomes}/*.{PARAMS[fasta_extension]} \
          -p {threads} \
          -sa {PARAMS[derep_ani_species]} \
          --S_algorithm fastANI \
          > {LOGS}/drep/drep.out \
          2> {LOGS}/drep/drep.err
        """


rule integrate_qc_taxonomy:
    input:
        manifest=rules.resolve_manifest.output,
