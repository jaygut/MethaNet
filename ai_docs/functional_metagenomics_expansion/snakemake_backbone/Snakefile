        gtdb_ar=rules.gtdbtk_all.output.ar,
        drep_cdb=rules.drep_all.output.cdb,
        drep_wdb=rules.drep_all.output.wdb,
    output:
        qc=f"{RESULTS}/cohort/qc_taxonomy/mag_qc_integrated.tsv",
        taxonomy=f"{RESULTS}/cohort/qc_taxonomy/taxonomy_resolved.tsv",
        derep=f"{RESULTS}/cohort/qc_taxonomy/derep_clusters.tsv",
    conda:
