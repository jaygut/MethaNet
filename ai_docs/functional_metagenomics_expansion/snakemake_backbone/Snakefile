"""
MethaNet functional-metagenomics production-contract backbone.

This Snakemake scaffold treats the current Apollo-3 Slurm production runner,
curator, and cohort consolidator as the source of truth. It is deliberately
orchestration-focused: Snakemake schedules the same per-MAG evidence bundle
contract instead of inventing a parallel output layout.
"""

from pathlib import Path
import csv

import pandas as pd


shell.executable("/bin/bash")

PROJECT_ROOT = Path(config["paths"]["project_root"]).resolve()
RESULTS = config["paths"]["results"]
LOGS = config["paths"]["logs"]
DB = config["databases"]
PARAMS = config["params"]
THREADS = config["threads"]
RESOURCES = config["resources"]

COHORT_RUN_ID = config.get("cohort_run_id") or config.get("run_id") or Path(RESULTS).name
MANIFEST = config["inputs"]["mag_manifest"]
PILOT_MAG_ID = config.get("pilot_mag_id") or config.get("pilot", {}).get("pilot_mag_id")

RUNNER = config["paths"].get("runner", "scripts/slurm/run_one_mag_functional_smoke_apollo3.sh")
CURATOR = config["paths"].get("curator", "scripts/curate_functional_mag_run.py")
CONSOLIDATOR = config["paths"].get("consolidator", "scripts/consolidate_functional_mag_cohort.py")
CONDA_SH = config["paths"].get("conda_sh", "/opt/ohpc/pub/apps/miniconda3/etc/profile.d/conda.sh")


def config_bool(value):
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in {"1", "true", "yes", "on"}


def repo_path(value):
    path = Path(str(value))
    if path.is_absolute():
        return path
    return PROJECT_ROOT / path


RUN_EGGNOG_V2 = config_bool(config.get("run_eggnog_v2", PARAMS.get("run_eggnog_v2", True)))
PRUNE_SUCCESS = config_bool(PARAMS.get("prune_success", True))
COMPRESS_LOGS = config_bool(PARAMS.get("compress_logs", True))
PREPARE_DBCAN_CACHE = config_bool(PARAMS.get("prepare_dbcan_cache", True))


def resolve_existing_path(value):
    return str(repo_path(value))


def load_manifest():
    manifest = pd.read_csv(repo_path(MANIFEST), sep="\t", dtype=str).fillna("")
    if "fasta_path" not in manifest.columns and "mag_fasta" in manifest.columns:
        manifest["fasta_path"] = manifest["mag_fasta"]
    if "proteome_id" not in manifest.columns:
        if "sample" in manifest.columns:
            manifest["proteome_id"] = manifest["sample"]
        else:
            manifest["proteome_id"] = manifest["mag_id"]
    if "functional_run_include" in manifest.columns:
        include_mask = manifest["functional_run_include"].str.lower()
        manifest = manifest.loc[include_mask.isin({"true", "1", "yes"})].copy()
    required = {"proteome_id", "mag_id", "fasta_path", "ecosystem", "source"}
    missing = required - set(manifest.columns)
    if missing:
        raise ValueError(f"mag_manifest missing required columns: {sorted(missing)}")
    if "proteome_faa" not in manifest.columns:
        manifest["proteome_faa"] = ""
    if manifest["proteome_id"].duplicated().any():
        dupes = sorted(manifest.loc[manifest["proteome_id"].duplicated(), "proteome_id"].unique())
        raise ValueError(f"mag_manifest contains duplicate proteome_id values: {dupes[:10]}")
    if manifest["mag_id"].duplicated().any():
        dupes = sorted(manifest.loc[manifest["mag_id"].duplicated(), "mag_id"].unique())
        raise ValueError(f"mag_manifest contains duplicate mag_id values: {dupes[:10]}")
    if PILOT_MAG_ID:
        pilot = str(PILOT_MAG_ID)
        manifest = manifest.loc[
            (manifest["mag_id"] == pilot) | (manifest["proteome_id"] == pilot)
        ].copy()
        if manifest.empty:
            raise ValueError(f"pilot_mag_id not found in manifest: {PILOT_MAG_ID}")
    return manifest


MAG_TABLE = load_manifest()
PROTEOMES = MAG_TABLE["proteome_id"].tolist()
MAG_BY_PROTEOME = dict(zip(MAG_TABLE["proteome_id"], MAG_TABLE["mag_id"]))
FASTA_BY_PROTEOME = dict(zip(MAG_TABLE["proteome_id"], MAG_TABLE["fasta_path"]))
FAA_BY_PROTEOME = dict(zip(MAG_TABLE["proteome_id"], MAG_TABLE["proteome_faa"]))


def snakemake_run_id(proteome_id):
    return f"snakemake_{proteome_id}"


def run_dir(proteome_id):
    return f"{RESULTS}/per_mag/{proteome_id}/{snakemake_run_id(proteome_id)}"


def run_dir_abs(proteome_id):
    return str(repo_path(run_dir(proteome_id)))


def mag_id_for_proteome(wildcards):
    return MAG_BY_PROTEOME[wildcards.proteome_id]


def mag_fasta_for_proteome(wildcards):
    return resolve_existing_path(FASTA_BY_PROTEOME[wildcards.proteome_id])


def proteome_faa_for_proteome(wildcards):
    value = FAA_BY_PROTEOME.get(wildcards.proteome_id, "")
    return resolve_existing_path(value) if value else resolve_existing_path(FASTA_BY_PROTEOME[wildcards.proteome_id])


def eggnog_path_for_proteome(proteome_id):
    mag_id = MAG_BY_PROTEOME[proteome_id]
    return f"{run_dir(proteome_id)}/eggnog/{mag_id}.emapper.annotations"


def optional_eggnog_input(wildcards):
    return [eggnog_path_for_proteome(wildcards.proteome_id)] if RUN_EGGNOG_V2 else []


def flag(enabled, text):
    return text if enabled else ""


PER_MAG_COMPLETE = expand(
    f"{RESULTS}/per_mag/{{proteome_id}}/snakemake_{{proteome_id}}/COMPLETE",
    proteome_id=PROTEOMES,
)
CURATED_RUN_RECORDS = expand(
    f"{RESULTS}/per_mag/{{proteome_id}}/snakemake_{{proteome_id}}/curated/run_record.json",
    proteome_id=PROTEOMES,
)
CURATED_FILE_MANIFESTS = expand(
    f"{RESULTS}/per_mag/{{proteome_id}}/snakemake_{{proteome_id}}/curated/file_manifest.tsv",
    proteome_id=PROTEOMES,
)
CURATED_PARQUET_MANIFESTS = expand(
    f"{RESULTS}/per_mag/{{proteome_id}}/snakemake_{{proteome_id}}/curated/parquet_manifest.tsv",
    proteome_id=PROTEOMES,
)
EGGNOG_OUTPUTS = [eggnog_path_for_proteome(proteome_id) for proteome_id in PROTEOMES] if RUN_EGGNOG_V2 else []


rule all:
    input:
        f"{RESULTS}/manifests/mag_manifest.resolved.tsv",
        f"{RESULTS}/manifests/tool_db_manifest.tsv",
        CURATED_RUN_RECORDS,
        CURATED_FILE_MANIFESTS,
        CURATED_PARQUET_MANIFESTS,
        EGGNOG_OUTPUTS,
        f"{RESULTS}/cohort_warehouse/DATA_ARCHITECTURE_VALIDATION.md",
        f"{RESULTS}/cohort_warehouse/cohort_table_manifest.tsv",
        f"{RESULTS}/cohort_warehouse/validation_gates.tsv",
        f"{RESULTS}/cohort_warehouse/functional_atlas.duckdb",


rule resolve_manifest:
    input:
        manifest=resolve_existing_path(MANIFEST),
    output:
        f"{RESULTS}/manifests/mag_manifest.resolved.tsv",
    run:
        out = MAG_TABLE.copy()
        out.insert(0, "cohort_run_id", COHORT_RUN_ID)
        out["snakemake_run_id"] = out["proteome_id"].map(snakemake_run_id)
        out["snakemake_run_dir"] = out["proteome_id"].map(run_dir)
        for col in ("fasta_path", "mag_fasta", "proteome_faa"):
            if col in out.columns:
                out[f"{col}_abs"] = out[col].map(lambda value: resolve_existing_path(value) if value else "")
        Path(output[0]).parent.mkdir(parents=True, exist_ok=True)
        out.to_csv(output[0], sep="\t", index=False)


rule write_tool_db_manifest:
    output:
        f"{RESULTS}/manifests/tool_db_manifest.tsv",
    run:
        rows = []
        for name, value in sorted(DB.items()):
            path = repo_path(value)
            rows.append({
                "cohort_run_id": COHORT_RUN_ID,
                "database": name,
                "path": str(path),
                "exists": path.exists(),
                "is_file": path.is_file(),
                "is_dir": path.is_dir(),
                "bytes": path.stat().st_size if path.exists() and path.is_file() else "",
            })
        Path(output[0]).parent.mkdir(parents=True, exist_ok=True)
        with open(output[0], "w", newline="") as handle:
            writer = csv.DictWriter(handle, fieldnames=list(rows[0].keys()), delimiter="\t")
            writer.writeheader()
            writer.writerows(rows)


rule validate_eggnog_v2_db:
    output:
        touch(f"{RESULTS}/manifests/eggnog_v2.ready"),
    threads:
        THREADS["light"]
    resources:
        mem_mb=RESOURCES["mem_light_mb"]
    conda:
        "envs/annotation.yaml"
    shell:
        """
        set -euo pipefail
        mkdir -p {RESULTS}/manifests {LOGS}/eggnog
        test -s {DB[eggnog_v2]}/eggnog.db
        test -s {DB[eggnog_v2]}/eggnog.taxa.db
        test -s {DB[eggnog_v2]}/eggnog.taxa.db.traverse.pkl
        test -s {DB[eggnog_v2]}/eggnog_proteins.dmnd
        diamond dbinfo --db {DB[eggnog_v2]}/eggnog_proteins.dmnd \
          > {LOGS}/eggnog/eggnog_v2_dbinfo.out \
          2> {LOGS}/eggnog/eggnog_v2_dbinfo.err
        emapper.py --data_dir {DB[eggnog_v2]} --version \
          > {LOGS}/eggnog/eggnog_v2_emapper_version.out \
          2> {LOGS}/eggnog/eggnog_v2_emapper_version.err
        """


rule run_one_mag_tools:
    input:
        fasta=mag_fasta_for_proteome,
        proteome_faa=proteome_faa_for_proteome,
        runner=resolve_existing_path(RUNNER),
    output:
        complete=f"{RESULTS}/per_mag/{{proteome_id}}/snakemake_{{proteome_id}}/COMPLETE",
    params:
        mag_id=mag_id_for_proteome,
        run_id=lambda wildcards: snakemake_run_id(wildcards.proteome_id),
        run_dir=lambda wildcards: run_dir_abs(wildcards.proteome_id),
        dbcan_compat_dir=str(repo_path(PARAMS.get("dbcan_compat_dir", f"{DB['db_root']}/dbcan_compat_pressed"))),
        prepare_dbcan_cache="1" if PREPARE_DBCAN_CACHE else "0",
    threads:
        THREADS["medium"]
    resources:
        mem_mb=RESOURCES.get("mem_production_mb", 128000)
    shell:
        """
        set -euo pipefail
        mkdir -p {params.run_dir:q}
        export REPO_ROOT={PROJECT_ROOT:q}
        export DB_ROOT={DB[db_root]:q}
        export FASTA={input.fasta:q}
        export PROTEOME_FAA={input.proteome_faa:q}
        export PROTEOME_ID={wildcards.proteome_id:q}
        export MAG_ID={params.mag_id:q}
        export THREADS={threads}
        export RUN_ID={params.run_id:q}
        export RESULT_ROOT={params.run_dir:q}
        export COHORT_RUN_ID={COHORT_RUN_ID:q}
        export DBCAN_COMPAT_DIR={params.dbcan_compat_dir:q}
        export PREPARE_DBCAN_CACHE={params.prepare_dbcan_cache:q}
        export CURATE_RUN=0
        export PRUNE_SUCCESS=0
        export COMPRESS_LOGS=0
        export CONDA_SH={CONDA_SH:q}
        {input.runner:q}
        test -s {output.complete:q}
        test -s {params.run_dir:q}/genes/{params.mag_id:q}.faa
        """


rule eggnog_v2_contract:
    input:
        complete=f"{RESULTS}/per_mag/{{proteome_id}}/snakemake_{{proteome_id}}/COMPLETE",
        db_ready=rules.validate_eggnog_v2_db.output,
    output:
        annotations=f"{RESULTS}/per_mag/{{proteome_id}}/snakemake_{{proteome_id}}/eggnog/{{mag_id}}.emapper.annotations",
    params:
        run_dir=lambda wildcards: run_dir_abs(wildcards.proteome_id),
        expected_mag_id=mag_id_for_proteome,
    threads:
        THREADS["medium"]
    resources:
        mem_mb=RESOURCES.get("mem_eggnog_mb", RESOURCES["mem_medium_mb"])
    conda:
        "envs/annotation.yaml"
    shell:
        """
        set -euo pipefail
        if [[ {wildcards.mag_id:q} != {params.expected_mag_id:q} ]]; then
          echo "MAG wildcard does not match manifest for {wildcards.proteome_id}: {wildcards.mag_id} != {params.expected_mag_id}" >&2
          exit 2
        fi
        mkdir -p {params.run_dir:q}/eggnog {LOGS}/eggnog
        emapper.py \
          -m diamond \
          --itype proteins \
          -i {params.run_dir:q}/genes/{wildcards.mag_id:q}.faa \
          --data_dir {DB[eggnog_v2]:q} \
          --cpu {threads} \
          -o {wildcards.mag_id:q} \
          --output_dir {params.run_dir:q}/eggnog \
          --override \
          > {LOGS}/eggnog/{wildcards.proteome_id}.out \
          2> {LOGS}/eggnog/{wildcards.proteome_id}.err
        test -s {output.annotations:q}
        """


rule curate_mag_contract:
    input:
        complete=f"{RESULTS}/per_mag/{{proteome_id}}/snakemake_{{proteome_id}}/COMPLETE",
        eggnog=optional_eggnog_input,
        fasta=mag_fasta_for_proteome,
        proteome_faa=proteome_faa_for_proteome,
        curator=resolve_existing_path(CURATOR),
    output:
        run_record=f"{RESULTS}/per_mag/{{proteome_id}}/snakemake_{{proteome_id}}/curated/run_record.json",
        file_manifest=f"{RESULTS}/per_mag/{{proteome_id}}/snakemake_{{proteome_id}}/curated/file_manifest.tsv",
        parquet_manifest=f"{RESULTS}/per_mag/{{proteome_id}}/snakemake_{{proteome_id}}/curated/parquet_manifest.tsv",
    params:
        mag_id=mag_id_for_proteome,
        run_dir=lambda wildcards: run_dir_abs(wildcards.proteome_id),
        compress_logs=flag(COMPRESS_LOGS, "--compress-logs"),
        prune_success=flag(PRUNE_SUCCESS, "--prune-success"),
    threads:
        THREADS["light"]
    resources:
        mem_mb=RESOURCES["mem_light_mb"]
    shell:
        """
        set -euo pipefail
        source {CONDA_SH:q}
        conda activate methanet-fgx
        python {input.curator:q} \
          --run-dir {params.run_dir:q} \
          --repo-root {PROJECT_ROOT:q} \
          --proteome-id {wildcards.proteome_id:q} \
          --mag-id {params.mag_id:q} \
          --cohort-run-id {COHORT_RUN_ID:q} \
          --cpus {threads} \
          --mag-fasta {input.fasta:q} \
          --proteome-faa {input.proteome_faa:q} \
          --write-parquet \
          {params.compress_logs} \
          {params.prune_success}
        test -s {output.run_record:q}
        test -s {output.file_manifest:q}
        test -s {output.parquet_manifest:q}
        """


rule consolidate_cohort_contract:
    input:
        manifest=rules.resolve_manifest.output,
        parquet_manifests=CURATED_PARQUET_MANIFESTS,
        run_records=CURATED_RUN_RECORDS,
    output:
        validation=f"{RESULTS}/cohort_warehouse/DATA_ARCHITECTURE_VALIDATION.md",
        table_manifest=f"{RESULTS}/cohort_warehouse/cohort_table_manifest.tsv",
        gates=f"{RESULTS}/cohort_warehouse/validation_gates.tsv",
        duckdb=f"{RESULTS}/cohort_warehouse/functional_atlas.duckdb",
    params:
        cohort_dir=str(repo_path(RESULTS)),
        output_dir=str(repo_path(f"{RESULTS}/cohort_warehouse")),
        expected=len(PROTEOMES),
        consolidator=resolve_existing_path(CONSOLIDATOR),
    threads:
        THREADS["light"]
    resources:
        mem_mb=RESOURCES.get("mem_consolidate_mb", RESOURCES["mem_medium_mb"])
    shell:
        """
        set -euo pipefail
        source {CONDA_SH:q}
        conda activate methanet-fgx
        python {params.consolidator:q} \
          --repo-root {PROJECT_ROOT:q} \
          --cohort-run-id {COHORT_RUN_ID:q} \
          --cohort-dir {params.cohort_dir:q} \
          --manifest {input.manifest:q} \
          --output-dir {params.output_dir:q} \
          --expected-complete-count {params.expected} \
          --build-duckdb
        test -s {output.validation:q}
        test -s {output.table_manifest:q}
        test -s {output.gates:q}
        test -s {output.duckdb:q}
        """
