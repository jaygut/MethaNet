          --manifest {input.manifest} \
          --qc {input.qc} \
          --taxonomy {input.taxonomy} \
          --derep {input.derep} \
          --methane-panel {input.methane_panel} \
          --methane-completeness {input.methane_completeness} \
          --coverage {input.coverage} \
          --bridge-metrics {input.bridge_metrics} \
          --out-json {output.cards} \
          --out-summary {output.summary}
        """


rule latent_function_join:
    input:
        embedding_metadata=config["inputs"]["embedding_metadata"],
        bridge_metrics=config["inputs"]["bridge_metrics"],
        qc=rules.integrate_qc_taxonomy.output.qc,
        taxonomy=rules.integrate_qc_taxonomy.output.taxonomy,
        derep=rules.integrate_qc_taxonomy.output.derep,
        methane_panel=rules.aggregate_functional_matrices.output.methane_panel,
        methane_completeness=rules.aggregate_functional_matrices.output.methane_completeness,
        coverage=rules.aggregate_functional_matrices.output.coverage,
        bridge_cards=rules.build_bridge_cards.output.cards,
    output:
        features=f"{RESULTS}/cohort/latent_function/latent_function_joined_features.parquet",
        associations=f"{RESULTS}/cohort/latent_function/bridge_function_associations.tsv",
    conda:
        "envs/integration.yaml"
    shell:
        """
        mkdir -p {RESULTS}/cohort/latent_function
        python workflow/scripts/functional_metagenomics/build_latent_function_features.py \
          --embedding-metadata {input.embedding_metadata} \
          --bridge-metrics {input.bridge_metrics} \
          --qc {input.qc} \
          --taxonomy {input.taxonomy} \
          --derep {input.derep} \
          --methane-panel {input.methane_panel} \
          --methane-completeness {input.methane_completeness} \
          --coverage {input.coverage} \
          --bridge-cards {input.bridge_cards} \
          --out-features {output.features} \
          --out-associations {output.associations}
        """


rule platform_demo_artifacts:
    input:
        features=rules.latent_function_join.output.features,
