        """


rule metabolic_g_all:
    input:
        genomes=rules.stage_mag_set.output,
    output:
        summary=f"{RESULTS}/cohort/functional_matrices/metabolic/METABOLIC_result.xlsx",
    threads:
        THREADS["gtdbtk"]
    resources:
        mem_mb=config["resources"]["mem_bigmem_mb"]
    conda:
        "envs/annotation.yaml"
    shell:
        """
        mkdir -p {RESULTS}/cohort/functional_matrices/metabolic {LOGS}/metabolic
        ls {input.genomes}/*.{PARAMS[fasta_extension]} > {RESULTS}/cohort/functional_matrices/metabolic/genome_list.txt
        perl {DB[metabolic]}/METABOLIC-G.pl \
          -in-gn {RESULTS}/cohort/functional_matrices/metabolic/genome_list.txt \
          -o {RESULTS}/cohort/functional_matrices/metabolic \
          -t {threads} \
          > {LOGS}/metabolic/metabolic_g.out \
          2> {LOGS}/metabolic/metabolic_g.err
        """


rule aggregate_functional_matrices:
    input:
        manifest=rules.resolve_manifest.output,
        qc=rules.integrate_qc_taxonomy.output.qc,
        taxonomy=rules.integrate_qc_taxonomy.output.taxonomy,
        derep=rules.integrate_qc_taxonomy.output.derep,
        kofam=expand(f"{RESULTS}/per_mag/{{mag_id}}/annotation/kofam/{{mag_id}}.kofam.detail.tsv", mag_id=MAGS),
        eggnog=expand(f"{RESULTS}/per_mag/{{mag_id}}/annotation/eggnog/{{mag_id}}.emapper.annotations", mag_id=MAGS),
        mcycdb=expand(f"{RESULTS}/per_mag/{{mag_id}}/annotation/mcycdb/{{mag_id}}.mcycdb_hits.tsv", mag_id=MAGS),
        scycdb=expand(f"{RESULTS}/per_mag/{{mag_id}}/annotation/scycdb/{{mag_id}}.scycdb_hits.tsv", mag_id=MAGS),
        dbcan=expand(f"{RESULTS}/per_mag/{{mag_id}}/annotation/dbcan/overview.txt", mag_id=MAGS),
        dram=rules.dram_all.output.annotations,
        metabolic=rules.metabolic_g_all.output.summary,
    output:
        methane_panel=f"{RESULTS}/cohort/functional_matrices/methane_marker_panel.tsv",
        methane_completeness=f"{RESULTS}/cohort/functional_matrices/methane_pathway_completeness.tsv",
        coverage=f"{RESULTS}/cohort/functional_matrices/annotation_coverage_qc.tsv",
        ko=f"{RESULTS}/cohort/functional_matrices/ko_matrix.tsv",
        cazy=f"{RESULTS}/cohort/functional_matrices/cazy_family_matrix.tsv",
    conda:
        "envs/integration.yaml"
    shell:
        """
        mkdir -p {RESULTS}/cohort/functional_matrices
        python workflow/scripts/functional_metagenomics/aggregate_functional_matrices.py \
          --manifest {input.manifest} \
          --qc {input.qc} \
          --taxonomy {input.taxonomy} \
          --derep {input.derep} \
          --kofam-dir {RESULTS}/per_mag \
          --eggnog-dir {RESULTS}/per_mag \
          --mcycdb-dir {RESULTS}/per_mag \
          --scycdb-dir {RESULTS}/per_mag \
          --dbcan-dir {RESULTS}/per_mag \
          --dram {input.dram} \
          --metabolic {input.metabolic} \
          --out-methane-panel {output.methane_panel} \
          --out-methane-completeness {output.methane_completeness} \
          --out-coverage {output.coverage} \
          --out-ko {output.ko} \
          --out-cazy {output.cazy}
        """


