@prefix mvo: <https://emergentbiome.earth/ontology/mvo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

# Conservative subproperty reuse only. No global remote owl:imports, sameAs,
# class equivalences, or entailment that a marker predicts measured flux.
sosa:hasResult a owl:ObjectProperty .
sosa:hasFeatureOfInterest a owl:ObjectProperty .
sosa:observedProperty a owl:ObjectProperty .
mvo:hasResult rdfs:subPropertyOf sosa:hasResult .
mvo:featureOfInterest rdfs:subPropertyOf sosa:hasFeatureOfInterest .
mvo:observedProperty rdfs:subPropertyOf sosa:observedProperty .
