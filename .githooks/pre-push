#!/usr/bin/env bash
# Check every commit about to be pushed (identities, messages, additions).
# Git passes <remote> <url>; stdin lists "<local ref> <local sha> <remote ref> <remote sha>".
set -euo pipefail
remote="$1"
checker="$(git rev-parse --show-toplevel)/scripts/check_provenance.py"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue  # deleting a remote ref
  if [[ ! "$remote_sha" =~ ^0+$ ]] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    python3 "$checker" range "${remote_sha}..${local_sha}" || status=1
  else
    python3 "$checker" range "$local_sha" --not "--remotes=$remote" || status=1
  fi
done
exit "$status"
